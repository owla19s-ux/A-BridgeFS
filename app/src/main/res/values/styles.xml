<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/bridgefs_accent</item>
        <item name="android:colorControlHighlight">@color/bridgefs_ripple_orange</item>
        <item name="colorControlHighlight">@color/bridgefs_ripple_orange</item>
        <item name="android:navigationBarColor">@color/bridgefs_surface</item>
        <item name="android:statusBarColor">@color/bridgefs_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:checkboxStyle">@style/AbridgeCheckbox</item>
    </style>

    <style name="AbridgeCheckbox" parent="@android:style/Widget.CompoundButton.CheckBox">
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>
</resources>
